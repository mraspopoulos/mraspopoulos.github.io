---
import Base from '../layouts/Base.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('publications');
const sorted = all.sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const byYear: Record<number, typeof sorted> = {};
for (const pub of sorted) {
  const year = pub.data.year;
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(pub);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

const total = sorted.length;
const countBy = (t: string) => sorted.filter((p) => p.data.type === t).length;
const typeCounts = {
  all: total,
  journal: countBy('journal'),
  conference: countBy('conference'),
  chapter: countBy('chapter'),
  book: countBy('book'),
  preprint: countBy('preprint'),
};
---

<Base title="Publications — Marios Raspopoulos" active="publications">
  <h1>Publications</h1>
  <p style="color: var(--text-muted); margin-bottom: 0.5rem;">
    Full list in IEEE reference style, newest first. Selected works flagged on the <a href="/">homepage</a>.
    Open Access PDFs are linked where available.
  </p>
  <p style="color: var(--text-faint); font-size: 0.8rem; margin-bottom: 1.5rem;">
    Citations from <a href="https://www.semanticscholar.org/">Semantic Scholar</a>,
    updated daily. Numbers may differ from Google Scholar or Scopus.
  </p>

  <div class="pub-filter">
    <label for="pub-type-filter">Filter by type</label>
    <select id="pub-type-filter">
      <option value="all">All types ({typeCounts.all})</option>
      {typeCounts.journal > 0 && <option value="journal">Journal articles ({typeCounts.journal})</option>}
      {typeCounts.conference > 0 && <option value="conference">Conference papers ({typeCounts.conference})</option>}
      {typeCounts.chapter > 0 && <option value="chapter">Book chapters ({typeCounts.chapter})</option>}
      {typeCounts.book > 0 && <option value="book">Books ({typeCounts.book})</option>}
      {typeCounts.preprint > 0 && <option value="preprint">Preprints ({typeCounts.preprint})</option>}
    </select>
    <span class="pub-filter-count" id="pub-filter-count">Showing all {total} publications</span>
  </div>

  {years.map((year) => (
    <div class="year-group" data-year={year}>
      <h2 class="pub-year-heading">
        <span class="pub-year-count">{byYear[year].length} {byYear[year].length === 1 ? 'publication' : 'publications'}</span>
        <span>{year}</span>
      </h2>
      <ul class="pub-cite-list">
        {byYear[year].map((pub) => (
          <PublicationItem pub={pub} />
        ))}
      </ul>
    </div>
  ))}

  <p class="no-results-msg" id="no-results-msg" hidden>
    No publications match this filter.
  </p>
</Base>

<style>
  /* Year banner — grey background with accent left border, stands out
     clearly as a section divider without dominating the citation list. */
  .pub-year-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--accent, #1d3557);
    background: var(--bg-tint, #eef2f7);
    padding: 0.55rem 1rem;
    margin: 2.25rem 0 0.75rem;
    border-radius: 6px;
    border-left: 4px solid var(--accent, #1d3557);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .pub-year-count {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted, #515c6d);
    order: 2;
  }
  .pub-year-heading > span:last-child { order: 1; }

  .year-group:first-of-type .pub-year-heading { margin-top: 1rem; }

  .pub-cite-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
</style>

<script>
  const select = document.getElementById('pub-type-filter') as HTMLSelectElement | null;
  const countDisplay = document.getElementById('pub-filter-count');
  const noResults = document.getElementById('no-results-msg');

  function applyFilter() {
    if (!select) return;
    const value = select.value;
    let visibleCount = 0;
    document.querySelectorAll<HTMLElement>('li.pub-cite-item').forEach((item) => {
      const t = item.getAttribute('data-pub-type');
      const show = value === 'all' || t === value;
      item.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    document.querySelectorAll<HTMLElement>('.year-group').forEach((group) => {
      const anyVisible = Array.from(
        group.querySelectorAll<HTMLElement>('li.pub-cite-item'),
      ).some((item) => item.style.display !== 'none');
      group.style.display = anyVisible ? '' : 'none';
    });
    if (countDisplay) {
      if (value === 'all') {
        countDisplay.textContent = `Showing all ${visibleCount} publications`;
      } else {
        const label = select.options[select.selectedIndex].text
          .replace(/\s*\(\d+\)$/, '')
          .toLowerCase();
        countDisplay.textContent = `Showing ${visibleCount} ${label}`;
      }
    }
    if (noResults) noResults.hidden = visibleCount > 0;
  }

  select?.addEventListener('change', applyFilter);
</script>
